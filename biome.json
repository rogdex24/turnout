{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "e2e/**",
      "packages/**",
      "apps/**",
      "scripts/**",
      "bench/**",
      "*.ts",
      "*.json",
      "!src/admin/ui/components/ui",
      "!test/fixtures",
      "!packages/**/node_modules",
      "!packages/design-tokens/*.generated.*",
      "!apps/**/node_modules",
      "!apps/mobile/ios",
      "!apps/mobile/android",
      "!apps/mobile/.expo",
      "!apps/mobile/.rnstorybook/storybook.requires.ts",
      "!apps/mobile/uniwind-types.d.ts",
      "!apps/mobile/expo-env.d.ts",
      "!**/*.sqlite*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        }
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "SelectTrigger", "ComboboxInput"]
          }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "plugins": [
    {
      "path": "./lint/no-html-strings.grit",
      "includes": ["**/src/web/**"]
    },
    {
      "path": "./lint/no-color-literals.grit",
      "includes": ["**/apps/mobile/src/**"]
    },
    {
      "path": "./lint/no-history-writes.grit",
      "includes": ["**/src/web/map/**"]
    }
  ],
  "overrides": [
    {
      "includes": ["apps/mobile/src/**", "!apps/mobile/src/ui/primitives/SafeAreaView.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native-safe-area-context": {
                    "importNames": ["SafeAreaView"],
                    "message": "Uniwind ignores className on it. Import SafeAreaView from @/ui/primitives/SafeAreaView."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/ui/rawBlock.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
