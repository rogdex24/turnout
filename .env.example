# Names only. Every value is empty on purpose: this file is committed, so it never
# holds a secret, a token, a phone number or an email. Set real values in the host
# environment (a systemd EnvironmentFile outside the repo) and in git-ignored files.
# docs/deploy.md says where each one lives. Production refuses to start without the
# ones marked "required in production".

# Which environment this process is: production, staging, development or test.
# Required: `serve` refuses to start without it.
TURNOUT_ENV=

# Grievance officer block. Required in production. Shown in /privacy, the notice and settings.
GRIEVANCE_NAME=
GRIEVANCE_ADDRESS=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
SUPPORT_EMAIL=

# Server secrets. Required in production. Outside production a missing one is replaced by a
# random value for that run, so sessions end at a restart.
OTP_PEPPER=
BAN_PEPPER=
FILE_LINK_SECRET=
# ES256 key pair that signs access tokens, as PEM text with line breaks written as \n.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# Set only while rotating: the old public key, so tokens signed with it stay valid until they expire.
AUTH_JWT_PREVIOUS_PUBLIC_KEY=

# Sign-in codes (S3, S28). whatsapp or fake. Production only accepts whatsapp.
OTP_SENDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Sends allowed per IST day across everyone. Overrides the default cap.
OTP_DAILY_CAP=
# An https URL that takes {"text": "..."}. Without one, alerts go to the process log.
OPERATOR_ALERT_WEBHOOK_URL=

# Google review account (Play app access). Production only.
REVIEWER_PHONE=
REVIEWER_OTP=

# Staging and development only. Never set these in production.
# STAGING_TEST_TOKEN guards POST /__test/otp and POST /__test/clock. At least 32 characters.
STAGING_TEST_TOKEN=
# Comma separated fictional numbers that may sign in on staging.
TEST_PHONE_ALLOWLIST=
# Comma separated fictional numbers the fake sender reports as undeliverable.
FAKE_UNDELIVERABLE_PHONES=

# Files (S16). OBJECT_STORE is disk (default) or s3. Photos and tickets are not in the Litestream backup.
OBJECT_STORE=
FILES_DIR=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# App behaviour.
# Oldest app version the server still accepts, as x.y.z.
MIN_APP_VERSION=
# Platforms that get push, comma separated. Android only until the Apple account exists.
PUSH_PLATFORMS=
PUSH_SENDER=
EXPO_ACCESS_TOKEN=
# Name of the header that carries the client address behind the proxy (for example x-forwarded-for).
TRUST_PROXY_HEADER=

# Admin console (existing). A non-loopback ADMIN_HOST needs ADMIN_TOKEN.
ADMIN_HOST=
ADMIN_TOKEN=

# App links. The server publishes /.well-known/assetlinks.json only when both Android values are set, and answers 404 otherwise.
# Not secrets. The package is the Android application id of the production build.
APP_LINKS_ANDROID_PACKAGE=
# SHA-256 fingerprints of the signing certificates, comma separated (the Play App Signing key; add the upload key if wanted).
# Set after the first Play upload.
APP_LINKS_ANDROID_SHA256=
# `<team id>.<bundle id>`, comma separated. /.well-known/apple-app-site-association stays 404 until this is set (no Apple account yet).
APP_LINKS_IOS_APP_IDS=
# Host the app answers on, for example go.example.in (no scheme). The event page links "Go with a group" to https://<host>/e/<id>/go?src=web,
# and the site serves that page when the app is not installed. Unset, the event page shows no such link.
APP_LINKS_HOST=
# Google Play listing of the app. Unset, the fallback page says "The app is in testing on Android" with a contact link. No App Store badge.
PLAY_STORE_URL=

# Used later, not read by the server yet.
# Error reports (S21).
SENTRY_DSN=
# Maps key for the app build (EAS sensitive variable, and apps/mobile/.env.local for local runs).
GOOGLE_MAPS_ANDROID_API_KEY=
