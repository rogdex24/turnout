{
  "extends": "../tsconfig.json",
  // The specs run page code (document, getComputedStyle) inside the browser, so they get the DOM lib.
  // server.ts and run.ts are server programs and stay in the root project, which has no DOM lib.
  "compilerOptions": { "lib": ["ES2022", "DOM", "DOM.Iterable"] },
  "include": ["./*.spec.ts", "./fixtures.ts", "../playwright.config.ts"],
  "exclude": []
}
