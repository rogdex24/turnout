# EAS uploads the git repository root for a monorepo build. A build needs apps/mobile, packages/ (the contract and the design
# tokens), the root package.json and bun.lock. Everything else stays out of the upload.
/src
/test
/e2e
/bench
/data
/docs
/scripts
/lint
/.github
/.playwright-mcp
/DESIGN.md
/playwright.config.ts

# apps/mobile build outputs and test-only files
apps/mobile/ios
apps/mobile/android
apps/mobile/.expo
apps/mobile/dist
apps/mobile/.maestro
apps/mobile/build
apps/mobile/out
visual-diff-report/
**/.env.local
**/.env.*.local
**/google-services.json
**/GoogleService-Info.plist
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
apps/mobile/jest
apps/mobile/**/*.test.ts
apps/mobile/**/*.test.tsx
node_modules
