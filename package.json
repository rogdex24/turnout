{
  "name": "hydsocial-communitie-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Fetch Hyderabad events from Communitie and sync them into a local SQLite database.",
  "scripts": {
    "sync": "bun run src/cli.ts sync",
    "serve": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/admin/ui/tsconfig.json --noEmit && tsc -p src/web/ui/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "deps": "bun --bun depcruise src",
    "check": "bun run typecheck && bun run lint && bun run design:lint && bun test && bun run deps",
    "admin": "bun run src/cli.ts admin",
    "design:lint": "design.md lint DESIGN.md",
    "icons": "bun scripts/build-category-sprite.ts",
    "e2e": "bun e2e/run.ts",
    "lint": "biome check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/design.md": "0.4.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.5.0",
    "lefthook": "2.1.14",
    "shadcn": "4.21.4",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.13.0",
    "nuqs": "2.10.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
