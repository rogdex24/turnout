{
  "name": "hydsocial-communitie-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Fetch Hyderabad events from Communitie and sync them into a local SQLite database.",
  "scripts": {
    "sync": "bun run src/cli.ts sync",
    "serve": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/admin/ui/tsconfig.json --noEmit && tsc -p src/web/ui/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p packages/contract/tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "deps": "bun --bun depcruise src packages && bun --bun depcruise --ts-config \"$PWD/apps/mobile/tsconfig.json\" apps/mobile/src apps/mobile/config",
    "check:server": "bun run typecheck && bun run lint && bun run design:lint && bun test && bun run deps",
    "lint:mobile": "bun run --cwd apps/mobile lint",
    "test:mobile": "bun run --cwd apps/mobile test",
    "check:mobile": "bun run lint:mobile && bun run test:mobile",
    "check": "bun run check:server && bun run check:mobile",
    "secrets:scan": "gitleaks dir --redact .",
    "admin": "bun run src/cli.ts admin",
    "design:lint": "design.md lint DESIGN.md",
    "icons": "bun scripts/build-category-sprite.ts",
    "tokens:mobile": "bun scripts/build-mobile-tokens.ts",
    "e2e": "bun e2e/run.ts",
    "load-smoke": "bun scripts/load-smoke.ts",
    "lint": "biome check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/design.md": "0.4.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.5.0",
    "lefthook": "2.1.14",
    "odiff-bin": "4.5.0",
    "shadcn": "4.21.4",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@turnout/contract": "workspace:*",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "expo-server-sdk": "7.2.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.13.0",
    "nuqs": "2.10.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "patchedDependencies": {
    "expo-modules-jsi@58.0.21": "patches/expo-modules-jsi@58.0.21.patch"
  }
}
