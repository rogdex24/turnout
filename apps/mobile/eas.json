{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "bun": "1.4.3",
      "node": "24.22.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_STORYBOOK": "1" },
      "android": { "buildType": "apk" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "e2e", "EXPO_PUBLIC_STORYBOOK": "1", "EXPO_PUBLIC_ALLOW_CAPTURE": "1" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_STORYBOOK": "0" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_STORYBOOK": "0" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
